{
  "version": 3,
  "configurePresets": [{
    "name": "winlibs-x64",
    "displayName": "fsio: standalone WinLibs GCC, Windows x64",
    "generator": "Ninja",
    "binaryDir": "${sourceDir}/../../bld/winlibs-x64/fsio",
    "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_C_COMPILER": "C:/gcc-winlibs-x86_64/bin/gcc.exe",
      "CMAKE_MAKE_PROGRAM": "C:/gcc-winlibs-x86_64/bin/ninja.exe",
      "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
      "CMAKE_INSTALL_PREFIX": "${sourceDir}/../../bld/install/winlibs-x64",
      "CMAKE_EXPORT_COMPILE_COMMANDS": true,
      "FSIO_USE_READLINE": false,
      "BUILD_TESTING": true
    },
    "environment": {
      "PATH": "C:/gcc-winlibs-x86_64/bin;$penv{PATH}",
      "CMAKE_BUILD_PARALLEL_LEVEL": "1",
      "CTEST_PARALLEL_LEVEL": "1"
    }
  }],
  "buildPresets": [{"name": "winlibs-x64", "configurePreset": "winlibs-x64",
    "targets": ["fsio"], "jobs": 1}],
  "testPresets": [{"name": "winlibs-x64", "configurePreset": "winlibs-x64",
    "output": {"outputOnFailure": true},
    "execution": {"jobs": 1, "noTestsAction": "error"}}]
}
