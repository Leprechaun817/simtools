cmake_minimum_required(VERSION 3.21)

foreach(required IN ITEMS CONFIG11 CASE CASE_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()

set(table_count 1)
if(CASE STREQUAL "eof")
    set(input "")
    set(table_count 0)
elseif(CASE STREQUAL "empty")
    set(input "\n")
elseif(CASE STREQUAL "example")
    # The example published in config11.txt, including two controller instances.
    set(input "UDA50\n2\nDZ11\n2\n\n")
elseif(CASE STREQUAL "lowercase")
    set(input "uda50\n2\ndz11\n2\n\n")
elseif(CASE STREQUAL "invalid")
    set(input "NOT-A-CONTROLLER\nDZ11\nabc\nUDA50\n1\n\n")
elseif(CASE STREQUAL "limit")
    set(input "DZ11\n9\nDZ11\n-1\nDZ11\n8\n\n")
elseif(CASE STREQUAL "zero")
    set(input "UDA50\n0\n\n")
elseif(CASE STREQUAL "repeat")
    set(input "UDA50\n1\n\n\n")
    set(table_count 2)
else()
    message(FATAL_ERROR "Unknown case: ${CASE}")
endif()

file(MAKE_DIRECTORY "${CASE_DIR}")
file(WRITE "${CASE_DIR}/input.txt" "${input}")
execute_process(
    COMMAND "${CONFIG11}"
    INPUT_FILE "${CASE_DIR}/input.txt"
    OUTPUT_FILE "${CASE_DIR}/stdout.txt"
    ERROR_FILE "${CASE_DIR}/stderr.txt"
    RESULT_VARIABLE result
    TIMEOUT 10)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${CASE}: config11 returned ${result}; see ${CASE_DIR}")
endif()
file(READ "${CASE_DIR}/stdout.txt" output)
file(READ "${CASE_DIR}/stderr.txt" errors)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT errors STREQUAL "")
    message(FATAL_ERROR "${CASE}: unexpected stderr: ${errors}")
endif()

function(expect_text text)
    string(FIND "${output}" "${text}" position)
    if(position LESS 0)
        message(FATAL_ERROR "${CASE}: missing '${text}'; see ${CASE_DIR}/stdout.txt")
    endif()
endfunction()

expect_text("Enter configuration data\nName:\t")
string(REGEX MATCHALL "Rank\tName\tCtrl#\t CSR" tables "${output}")
list(LENGTH tables actual_table_count)
if(NOT actual_table_count EQUAL table_count)
    message(FATAL_ERROR "${CASE}: expected ${table_count} tables, got ${actual_table_count}")
endif()
string(REGEX MATCHALL "\n [0-9][0-9]\t" rows "${output}")
list(LENGTH rows row_count)
math(EXPR expected_rows "34 * ${table_count}")
if(NOT row_count EQUAL expected_rows)
    message(FATAL_ERROR "${CASE}: expected ${expected_rows} device rows, got ${row_count}")
endif()

if(table_count GREATER 0)
    expect_text(" 01\tDJ11\tgap\t760010\n")
endif()
if(CASE STREQUAL "example" OR CASE STREQUAL "lowercase")
    expect_text(" 08\tDZ11\t  1\t760100\n\t\t  2\t760110\n")
    expect_text(" 26\tUDA50\t  1\t772150*\n\t\t  2\t")
elseif(CASE STREQUAL "invalid")
    expect_text("Unknown controller, valid names are:")
    expect_text("Input error\n")
    expect_text(" 26\tUDA50\t  1\t772150*\n")
elseif(CASE STREQUAL "limit")
    string(REGEX MATCHALL "Too many controllers" rejected "${output}")
    list(LENGTH rejected rejection_count)
    if(NOT rejection_count EQUAL 2)
        message(FATAL_ERROR "${CASE}: expected rejection of both 9 and -1")
    endif()
    expect_text("\t\t  8\t760170\n")
elseif(CASE STREQUAL "zero" OR CASE STREQUAL "empty")
    expect_text(" 26\tUDA50\tgap\t")
elseif(CASE STREQUAL "repeat")
    expect_text(" 26\tUDA50\t  1\t772150*\n")
    expect_text(" 26\tUDA50\tgap\t")
endif()
message(STATUS "${CASE}: passed")
